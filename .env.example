# ResumeRewriteBench 环境变量模板
# 复制此文件为 .env，填入你的真实 API key
# .env 已被 .gitignore 忽略，不会进入 git 历史

# AiHubMix（推荐——支持 GPT-5 + Claude + Gemini 一个 key 全打）
# 注册：https://aihubmix.com
API_AIHUBMIX_KEY=sk-your-aihubmix-key-here

# 302.AI（备用代理，可选）
# 注册：https://302.ai
API_302AI_KEY=sk-your-302ai-key-here

# API2D（备用代理，可选）
# 与 fallback 配置中的 apiKeyEnvar 保持一致
KEY_API2D=fk-your-api2d-key-here

# GPTsAPI（备用代理，可选）
# 与 mixed-routing 配置中的 apiKeyEnvar 保持一致
KEY_GPTAI=sk-your-gptsapi-key-here
